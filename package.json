{
  "name": "trilok",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter @trilok/web dev",
    "build": "pnpm --filter @trilok/web build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/fetch-makehuman-core.mjs && vitest run tests/ --pool=threads --maxWorkers=1",
    "test:e2e": "playwright test",
    "bench:studio": "node scripts/fetch-makehuman-core.mjs && vitest run benchmarks/ --pool=threads --maxWorkers=1",
    "build:deployment": "pnpm build && node scripts/verify-build-identity.mjs",
    "animation:bake": "node scripts/fetch-makehuman-core.mjs && node scripts/bake-reference-animations.mjs --write",
    "animation:verify": "node scripts/fetch-makehuman-core.mjs && node scripts/bake-reference-animations.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.135.0",
    "three": "^0.180.0",
    "@types/three": "^0.180.0",
    "@playwright/test": "^1.56.1"
  },
  "pnpm": {
    "overrides": {
      "rollup": "4.68.3"
    }
  }
}
